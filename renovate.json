{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "First-party refs are pinned by scripts/pin-bump-refs.sh at release",
      "matchPackageNames": ["climate-resource/github-actions"],
      "enabled": false
    },
    {
      "description": "Group non-major updates to dev tooling and this repo's own CI",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "internal non-major"
    },
    {
      "description": "Actions consumers run ship in the next release. Must follow the internal rule to override it",
      "matchFileNames": ["*/action.yml", ".github/workflows/bump.yaml"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "shipped non-major"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions annotated with a renovate comment in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+[A-Za-z_]+: ?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ]
}
